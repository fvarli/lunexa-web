# Development: point to local API server
# Production: leave empty or unset for same-origin (nginx proxies /api → Express)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Cloudflare Turnstile site key (public, build-time baked into client bundle).
# Leave empty in local dev to skip the widget.
# Production: set to your real site key from the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
