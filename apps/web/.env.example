# Development: point to local API server
# Production: leave empty or unset for same-origin (nginx proxies /api → Express)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Cloudflare Turnstile site key (public, build-time baked into client bundle).
# Leave empty in local dev to skip the widget.
# Production: set to your real site key from the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# Empty = analytics disabled (no scripts loaded).
# Loaded only after the user accepts Analytics in the cookie consent banner.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML meta verification code.
# Empty = no verification tag rendered. Paste only the `content` value.
NEXT_PUBLIC_GSC_VERIFICATION=

# Sentry — error monitoring. All vars optional; missing values = no-op.
# Server DSN (errors caught via instrumentation.onRequestError).
SENTRY_DSN=
# Client DSN (errors caught via app/global-error.tsx). Public, ships in browser bundle.
NEXT_PUBLIC_SENTRY_DSN=
# Environment tag (e.g. "production", "staging"). Defaults to NODE_ENV.
SENTRY_ENV=
NEXT_PUBLIC_SENTRY_ENV=
# Build-time only — required to upload source maps. Without these, withSentryConfig
# is skipped entirely and builds work as plain Next config. NEVER commit auth token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Release id for Sentry + /api/health.version. Falls back to VERCEL_GIT_COMMIT_SHA
# or APP_COMMIT_SHA when unset.
NEXT_PUBLIC_APP_VERSION=
