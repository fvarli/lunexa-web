# ── Server ──
# Production: NODE_ENV=production (disables localhost CORS pattern)
NODE_ENV=development
PORT=4000

# Interface to bind. Unset = 0.0.0.0 in development (reachable from the LAN,
# handy for testing on a phone) and 127.0.0.1 in production. The local HTTPS
# stack sets HOST=127.0.0.1 and PORT=8420 so nginx is the only way in —
# see docs/LOCAL_DEVELOPMENT.md.
HOST=

# ── CORS ──
# Production: CORS_ORIGIN=https://uselunexa.com,https://www.uselunexa.com
# The localhost/127.0.0.1 pattern is allowed automatically outside production,
# but https://lunexa.test is not — a .test origin must be listed explicitly.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ── SMTP ──
SMTP_HOST=smtp.test.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=test@test.com
SMTP_PASS=

# ── Contact ──
CONTACT_RECEIVER=hello@test.com
ENABLE_AUTOREPLY=false

# ── Cloudflare Turnstile ──
# Leave empty in local dev to skip verification.
# Production: set to your real secret key from the Cloudflare dashboard.
TURNSTILE_SECRET_KEY=

# ── Newsletter (double opt-in) ──
# JWT signing secret for the 15-minute confirmation token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable the endpoint (returns 503).
NEWSLETTER_SECRET=

# Base URL used to build newsletter confirmation + unsubscribe links.
# Defaults to https://uselunexa.com when unset.
SITE_BASE_URL=http://localhost:3000

# ── Database (PostgreSQL + Prisma) ──
# Required for newsletter subscriber persistence.
# The target database must have the citext extension enabled:
#   CREATE EXTENSION IF NOT EXISTS citext;
# Run migrations with: npm run db:deploy  (or npm run db:migrate in dev)
DATABASE_URL=postgresql://lunexa_api:password@127.0.0.1:5432/lunexa?schema=public

# ── Rate-limit backend (optional) ──
# Today the API uses MemoryStore (per-process). Single-instance pm2 production
# is fine. For multi-instance / shared quota, install rate-limit-redis + ioredis
# and update lib/rate-limit-store.ts. See file header for the swap recipe.
# REDIS_URL=redis://127.0.0.1:6379

# ── Release / observability (optional) ──
# Surfaced in /api/health.commit + .version. Auto-detected from CI vars when set;
# manual override with these two:
APP_COMMIT_SHA=
APP_VERSION=
